# ============================================================
#  OVI — variables de entorno
#  Copia este archivo a .env y completa los valores.
#  IMPORTANTE: OVI usa su PROPIA base de datos, separada de
#  cualquier otro proyecto. NO reutilices la BD de otra app.
# ============================================================

# --- Base de datos (PostgreSQL, exclusiva de OVI) ---
# Crea una base gratuita nueva en https://neon.tech o https://supabase.com
# (o agrega Vercel Postgres al proyecto OVI en Vercel) y pega aquí la cadena.
# El build ejecuta `prisma db push` automáticamente para crear las tablas.
DATABASE_URL="postgresql://usuario:password@host/ovi?sslmode=require"

# --- Seguridad de la sesión ---
# Secreto para firmar las cookies de sesión (HMAC). Genera uno largo y aleatorio.
# Si se deja vacío se usa un valor de desarrollo (NO usar así en producción).
AUTH_SECRET=""

# --- Zona horaria de reportes (informativa) ---
# El Salvador no cambia de hora. Se usa America/El_Salvador (UTC-6).
TZ="America/El_Salvador"
