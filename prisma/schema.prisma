// ============================================================
//  OVI — Esquema de datos
//  Plataforma central de ventas de lotes del Grupo Inmobiliario
//  Chacón. Proyecto INDEPENDIENTE: base de datos exclusiva, sin
//  relación con ninguna otra aplicación.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------
//  Usuarios y accesos. Roles:
//   director   → ve TODO, administra el sistema (Director 1 y 2).
//   gerente    → gerente de ventas de una fuerza. Ve TODA la actividad
//                (transparencia) y administra a los usuarios de su fuerza.
//   asistente  → asistente ejecutiva/administrativa de una fuerza. Ve TODA la
//                actividad y administra usuarios de su fuerza (altas/bajas/reasignación).
//   vendedor   → vendedor de proyecto. Ve solo SU fuerza, en sus proyectos.
//   (lider_central / lider_sitio se conservan y se tratan como vendedor.)
//
//  Cada usuario corresponde a una PERSONA REAL (nombre, correo, celular) para
//  responsabilidad y trazabilidad, y queda supeditado a su superior (supervisor).
// ---------------------------------------------------------------
model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         String   @default("vendedor") // director | gerente | asistente | vendedor | lider_central | lider_sitio
  displayName  String   @default("") // nombre de la persona real
  email        String   @default("")
  phone        String   @default("") // celular
  // Fuerza de venta: interna | ucoes | destino | ambas
  fuerza       String   @default("ambas")
  // Debe cambiar la contraseña en el próximo ingreso (alta con "password").
  mustChangePassword Boolean @default(false)
  // Jerarquía: superior directo (para trazabilidad).
  supervisorId String?
  supervisor   User?    @relation("Supervisa", fields: [supervisorId], references: [id])
  subordinados User[]   @relation("Supervisa")
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignments ProjectAssignment[]
  registros   Registro[]          @relation("RegistradoPor")
  visitas     Visita[]
  negocios    Negocio[]
  abonos      Abono[]
  novedades   Novedad[]
}

// Asignación líder ↔ proyecto (un líder de central puede tener varios).
model ProjectAssignment {
  id        String  @id @default(cuid())
  userId    String
  projectId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
}

// ---------------------------------------------------------------
//  Proyectos (los 15+ desarrollos de lotes)
// ---------------------------------------------------------------
model Project {
  id          String   @id @default(cuid())
  codigo      String   @unique // código corto, ej. "CHA-001"
  nombre      String
  departamento String  @default("")
  municipio   String   @default("")
  // Fuerza responsable principal: interna | ucoes | ambas
  fuerza      String   @default("ambas")
  totalLotes  Int      @default(0)
  precioDesde Float    @default(0)
  estado      String   @default("activo") // activo | pausado | cerrado
  notas       String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignments ProjectAssignment[]
  lotes       Lote[]
  visitas     Visita[]
  negocios    Negocio[]
  novedades   Novedad[]
}

// Inventario de lotes (opcional pero recomendado). Estado derivado de negocios.
model Lote {
  id        String   @id @default(cuid())
  projectId String
  numero    String   // "Lote 24", "A-12", etc.
  area      Float    @default(0) // m² (vara² se puede anotar en notas)
  precio    Float    @default(0)
  estado    String   @default("disponible") // disponible | reservado | vendido | bloqueado
  notas     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  negocios  Negocio[]

  @@unique([projectId, numero])
}

// ---------------------------------------------------------------
//  Vendedores (quien cierra el negocio; interno o UCOES)
// ---------------------------------------------------------------
model Vendedor {
  id        String   @id @default(cuid())
  nombre    String
  fuerza    String   @default("interna") // interna | ucoes
  telefono  String   @default("")
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visitas   Visita[]
  negocios  Negocio[]
}

// ---------------------------------------------------------------
//  Visita — tope del embudo (prospecto que visita el proyecto)
// ---------------------------------------------------------------
model Visita {
  id             String   @id @default(cuid())
  projectId      String
  fecha          DateTime @default(now())
  clienteNombre  String
  clienteTelefono String  @default("")
  vendedorId     String?
  fuerza         String   @default("interna") // interna | ucoes
  origen         String   @default("otro")    // redes | referido | valla | pasando | evento | otro
  interesado     Boolean  @default(true)
  notas          String   @default("")
  registradoPorId String?
  createdAt      DateTime @default(now())

  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vendedor       Vendedor? @relation(fields: [vendedorId], references: [id])
  registradoPor  User?     @relation(fields: [registradoPorId], references: [id])

  @@index([projectId, fecha])
}

// ---------------------------------------------------------------
//  Negocio — la venta de un lote a lo largo de su ciclo de vida
//   estados: prospecto | reservado | vendido | en_mora | escriturado | caido
// ---------------------------------------------------------------
model Negocio {
  id             String   @id @default(cuid())
  projectId      String
  loteId         String?
  loteRef        String   @default("") // texto libre si no se usa inventario
  clienteNombre  String
  clienteTelefono String  @default("")
  vendedorId     String?
  fuerza         String   @default("interna") // interna | ucoes
  estado         String   @default("reservado")

  precioLote     Float    @default(0)
  prima          Float    @default(0) // enganche pactado
  // saldo se calcula: precioLote - sum(abonos). Se guarda cache opcional.

  fechaReserva   DateTime?
  fechaVenta     DateTime?
  fechaEscritura DateTime?
  fechaCaida     DateTime?
  motivoCaida    String   @default("")

  notas          String   @default("")
  registradoPorId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  lote           Lote?     @relation(fields: [loteId], references: [id])
  vendedor       Vendedor? @relation(fields: [vendedorId], references: [id])
  registradoPor  User?     @relation(fields: [registradoPorId], references: [id])
  abonos         Abono[]

  @@index([projectId, estado])
}

// ---------------------------------------------------------------
//  Abono — pago hecho hacia un negocio (prima, cuota o contado)
// ---------------------------------------------------------------
model Abono {
  id             String   @id @default(cuid())
  negocioId      String
  fecha          DateTime @default(now())
  monto          Float    @default(0)
  tipo           String   @default("cuota") // prima | cuota | contado
  metodo         String   @default("efectivo") // efectivo | deposito
  referencia     String   @default("")
  // Foto de la boleta/comprobante (obligatoria si método = deposito).
  boletaFileId   String?
  // Estado de sincronización con Contabilidad (integración futura).
  contabilidadSync Boolean @default(false)
  registradoPorId String?
  createdAt      DateTime @default(now())

  negocio        Negocio    @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  registradoPor  User?      @relation(fields: [registradoPorId], references: [id])
  boleta         StoredFile? @relation(fields: [boletaFileId], references: [id])

  @@index([negocioId, fecha])
}

// ---------------------------------------------------------------
//  Novedad — problemas / "nuevas" / notas operativas del proyecto
// ---------------------------------------------------------------
model Novedad {
  id             String   @id @default(cuid())
  projectId      String
  fecha          DateTime @default(now())
  categoria      String   @default("operativo") // operativo | legal | infraestructura | cliente | administrativo | otro
  titulo         String
  detalle        String   @default("")
  prioridad      String   @default("media") // baja | media | alta
  estado         String   @default("abierta") // abierta | en_proceso | resuelta
  registradoPorId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  registradoPor  User?    @relation(fields: [registradoPorId], references: [id])

  @@index([projectId, estado])
}

// ---------------------------------------------------------------
//  Registro — bitácora unificada de auditoría (quién registró qué y cuándo).
//  Alimenta el "feed de actividad" del dashboard sin tener que unir 4 tablas.
// ---------------------------------------------------------------
model Registro {
  id             String   @id @default(cuid())
  tipo           String   // visita | reserva | venta | abono | caida | novedad | escritura
  projectId      String   @default("")
  refId          String   @default("") // id del objeto relacionado
  resumen        String   @default("")
  monto          Float    @default(0)
  registradoPorId String?
  createdAt      DateTime @default(now())

  registradoPor  User?    @relation("RegistradoPor", fields: [registradoPorId], references: [id])

  @@index([createdAt])
  @@index([projectId, createdAt])
}

// ---------------------------------------------------------------
//  StoredFile — archivos guardados EN LA BASE (sin depender de un
//  almacenamiento externo). Sirve para boletas de depósito (imágenes)
//  y documentos de inventario (PDF / Excel). Se sirven vía /api/file/<id>.
// ---------------------------------------------------------------
model StoredFile {
  id        String   @id @default(cuid())
  nombre    String   @default("")
  mimeType  String   @default("application/octet-stream")
  kind      String   @default("otro") // boleta | inventario | otro
  bytes     Bytes
  size      Int      @default(0)
  subidoPorId String?
  createdAt DateTime @default(now())

  abonos    Abono[]
}

// ---------------------------------------------------------------
//  SecurityLog — bitácora de seguridad de acciones privilegiadas:
//  carga/descarga de inventarios, cambios de precio de lote, etc.
//  Toda acción sensible queda registrada con el usuario que la ejecutó.
// ---------------------------------------------------------------
model SecurityLog {
  id         String   @id @default(cuid())
  accion     String   // inventario_import | inventario_export | lote_precio | lote_alta | doc_upload | ...
  detalle    String   @default("")
  projectId  String   @default("")
  userId     String   @default("")
  userName   String   @default("")
  userRole   String   @default("")
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([projectId, createdAt])
}

// ---------------------------------------------------------------
//  InventoryImport — registro de cada carga de inventario de un
//  proyecto (Excel / PDF), con el archivo fuente guardado.
// ---------------------------------------------------------------
model InventoryImport {
  id         String   @id @default(cuid())
  projectId  String
  fileId     String?  // StoredFile con el documento fuente
  formato    String   @default("excel") // excel | csv | pdf
  filas      Int      @default(0)
  creados    Int      @default(0)
  actualizados Int    @default(0)
  userId     String   @default("")
  userName   String   @default("")
  createdAt  DateTime @default(now())

  @@index([projectId, createdAt])
}
